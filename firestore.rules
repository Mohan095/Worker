rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // USERS COLLECTION
    // users/{uid}
    match /users/{userId} {
      // Authenticated users can read and write only their own profile document
      allow read: if isAuthenticated() && (request.auth.uid == userId);
      allow create: if isAuthenticated() && (request.auth.uid == userId);
      allow update: if isAuthenticated() && (request.auth.uid == userId);
      allow delete: if false; // Profiles cannot be deleted directly
    }

    // WORKS COLLECTION
    // works/{workId}
    match /works/{workId} {
      // Anyone authenticated can read active works, or the owner can read their own works
      allow read: if isAuthenticated() && (
        resource.data.status == "active" || resource.data.postedBy == request.auth.uid
      );

      // Authenticated users can create a work, but postedBy must match their UID
      allow create: if isAuthenticated() && request.resource.data.postedBy == request.auth.uid;

      // Only the work owner can update, deactivate, or delete their work
      // Allow applicantsCount increment by authenticated applicants during application submission
      allow update: if isAuthenticated() && (
        resource.data.postedBy == request.auth.uid ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicantsCount']) &&
          request.resource.data.applicantsCount == resource.data.applicantsCount + 1
        )
      );

      allow delete: if isAuthenticated() && resource.data.postedBy == request.auth.uid;
    }

    // APPLICATIONS COLLECTION
    // applications/{applicationId}
    match /applications/{applicationId} {
      // An application can be read by:
      // 1. The applicant themselves (applicantId == request.auth.uid)
      // 2. The owner of the corresponding work posting
      allow read: if isAuthenticated() && (
        resource.data.applicantId == request.auth.uid ||
        get(/databases/$(database)/documents/works/$(resource.data.workId)).data.postedBy == request.auth.uid
      );

      // Authenticated users can submit applications for themselves only
      allow create: if isAuthenticated() && request.resource.data.applicantId == request.auth.uid;

      // Only authorized work owner can change application status (e.g. pending -> accepted / rejected)
      allow update: if isAuthenticated() && (
        get(/databases/$(database)/documents/works/$(resource.data.workId)).data.postedBy == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      );

      allow delete: if false;
    }
  }
}
