rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // USERS COLLECTION
    // users/{userId}
    match /users/{userId} {
      // Authenticated user can read, create, and update only their own profile
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // WORKS COLLECTION
    // works/{workId}
    match /works/{workId} {
      // Anyone can read active, unexpired work posts; owners can read their own works
      allow read: if (
        resource.data.status == "active" &&
        (resource.data.expiresAt == null || request.time < resource.data.expiresAt)
      ) || (
        isAuthenticated() && resource.data.ownerId == request.auth.uid
      );

      // Authenticated users can create work; ownerId must match auth UID
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.status == "active" &&
        request.resource.data.applicantsCount == 0 &&
        request.resource.data.expiresAt > request.time;

      // Only work owner can edit/deactivate/delete their work
      // Allow applicantsCount increment by 1 for applying to an active unexpired work
      allow update: if isAuthenticated() && (
        (
          resource.data.ownerId == request.auth.uid &&
          request.resource.data.ownerId == resource.data.ownerId
        ) || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicantsCount']) &&
          request.resource.data.applicantsCount == resource.data.applicantsCount + 1 &&
          resource.data.status == "active" &&
          (resource.data.expiresAt == null || request.time < resource.data.expiresAt)
        )
      );

      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // APPLICATIONS COLLECTION
    // applications/{applicationId}
    match /applications/{applicationId} {
      // Readable by applicant or work owner
      allow read: if isAuthenticated() && (
        resource.data.applicantId == request.auth.uid ||
        get(/databases/$(database)/documents/works/$(resource.data.workId)).data.ownerId == request.auth.uid
      );

      // Authenticated user can apply for themselves only
      // Backend validation: work must be active and current time < expiresAt
      allow create: if isAuthenticated() &&
        request.resource.data.applicantId == request.auth.uid &&
        request.resource.data.status == "pending" &&
        get(/databases/$(database)/documents/works/$(request.resource.data.workId)).data.status == "active" &&
        request.time < get(/databases/$(database)/documents/works/$(request.resource.data.workId)).data.expiresAt;

      // Only authorized work owner can update application status
      allow update: if isAuthenticated() &&
        get(/databases/$(database)/documents/works/$(resource.data.workId)).data.ownerId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        (request.resource.data.status in ['pending', 'accepted', 'rejected']);

      allow delete: if false;
    }
  }
}
